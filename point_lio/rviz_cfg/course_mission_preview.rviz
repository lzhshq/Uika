Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Cell Size: 0.5
      Color: 120; 120; 120
      Alpha: 0.3
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Name: Map Origin
      Reference Frame: map
      Length: 1.5
      Radius: 0.06
      Value: true
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Clean 2D Map
      Topic:
        Value: /map
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Alpha: 0.72
      Color Scheme: map
      Draw Behind: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Current Half Tasks
      Topic:
        Value: /course_markers
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Current Half Route
      Topic:
        Value: /course_route
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Color: 30; 160; 255
      Line Style: Lines
      Line Width: 0.04
      Buffer Length: 1
      Pose Style: None
      Value: true
  Enabled: true
  Global Options:
    Background Color: 28; 28; 28
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: Semantic Alignment Top View
      Scale: 65
      Target Frame: map
      X: -0.3
      Y: 2.6
    Saved: ~
Window Geometry:
  Height: 1280
  Width: 1850
  X: 20
  Y: 35
