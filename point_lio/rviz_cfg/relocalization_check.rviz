Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Cell Size: 0.5
      Color: 130; 130; 130
      Alpha: 0.35
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Local PCD Map
      Topic:
        Value: /relocalization/local_map
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Alpha: 0.75
      Color: 170; 180; 195
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.035
      Style: Points
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Aligned Current Cloud
      Topic:
        Value: /relocalization/aligned_cloud
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Alpha: 1
      Color: 40; 240; 90
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.045
      Style: Points
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Name: Base Link
      Reference Frame: base_link
      Length: 0.5
      Radius: 0.025
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: PointLIO Path
      Topic:
        Value: /path
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 10
      Color: 255; 210; 40
      Alpha: 1
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.05
      Pose Style: None
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Fixed Route
      Topic:
        Value: /slalom_route
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Color: 25; 140; 255
      Alpha: 1
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.04
      Pose Style: None
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 7
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.9
      Target Frame: map
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1280
  X: 80
  Y: 60
