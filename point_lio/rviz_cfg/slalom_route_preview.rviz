Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Cell Size: 0.5
      Color: 120; 120; 120
      Alpha: 0.3
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Original PCD
      Topic:
        Value: /offline_map_cloud
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
      Alpha: 0.75
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 2.0
        Min Value: -1.0
        Value: true
      Axis: Z
      Channel Name: intensity
      Color Transformer: AxisColor
      Decay Time: 0
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.025
      Style: Points
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Slalom Geometry
      Topic:
        Value: /slalom_markers
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Slalom Route
      Topic:
        Value: /slalom_route
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Color: 25; 140; 255
      Line Style: Lines
      Line Width: 0.04
      Buffer Length: 1
      Pose Style: None
      Value: true
  Enabled: true
  Global Options:
    Background Color: 25; 25; 25
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.0
      Focal Point:
        X: 2.0
        Y: 0.6
        Z: 0.0
      Name: Current View
      Pitch: 1.55
      Target Frame: map
      Yaw: 0.0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1280
  X: 80
  Y: 60
