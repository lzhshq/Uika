Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Cell Size: 1
      Color: 160; 160; 164
      Alpha: 0.5
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Show Arrows: false
      Show Axes: false
      Show Names: false
      Marker Scale: 0.2
      Update Interval: 0
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: FAST-LIO Registered Cloud
      Decay Time: 30
      Topic:
        Value: /cloud_registered
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Flat Squares
      Size (Pixels): 3
      Size (m): 0.01
      Alpha: 1
      Color Transformer: AxisColor
      Axis: Z
      Position Transformer: XYZ
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: FAST-LIO Body Cloud
      Topic:
        Value: /cloud_registered_body
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 2
      Size (m): 0.02
      Alpha: 1
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Position Transformer: XYZ
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: FAST-LIO Accumulated Map
      Topic:
        Value: /Laser_map
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Style: Flat Squares
      Size (Pixels): 2
      Size (m): 0.015
      Alpha: 0.85
      Color Transformer: AxisColor
      Axis: Z
      Position Transformer: XYZ
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: FAST-LIO Odometry
      Topic:
        Value: /Odometry
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Keep: 10
      Shape:
        Value: Axes
        Axes Length: 0.25
        Axes Radius: 0.02
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: FAST-LIO Path
      Topic:
        Value: /path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Line Style: Lines
      Line Width: 0.04
      Color: 0; 170; 255
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: PCT Planned Path
      Topic:
        Value: /planned_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Line Style: Lines
      Line Width: 0.08
      Color: 255; 128; 0
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Follower Path
      Topic:
        Value: /follower_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Line Style: Lines
      Line Width: 0.05
      Color: 0; 255; 120
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Local Map
      Topic:
        Value: /local_map
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Flat Squares
      Size (Pixels): 3
      Size (m): 0.04
      Alpha: 0.8
      Color Transformer: AxisColor
      Axis: Z
      Position Transformer: XYZ
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Ground
      Topic:
        Value: /ground
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Flat Squares
      Size (Pixels): 3
      Size (m): 0.05
      Alpha: 0.9
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Position Transformer: XYZ
      Use Fixed Frame: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Orbit
      Pitch: 0.8
      Target Frame: <Fixed Frame>
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
  X: 80
  Y: 40
