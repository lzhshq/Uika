Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Cell Size: 1
      Color: 160; 160; 164
      Alpha: 0.45
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.25
      Update Interval: 0
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: FAST-LIO Odometry
      Topic:
        Value: /Odometry
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Keep: 80
      Shape:
        Value: Axes
        Axes Length: 0.25
        Axes Radius: 0.02
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: FAST-LIO Internal Path
      Topic:
        Value: /path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Line Style: Lines
      Line Width: 0.06
      Color: 255; 180; 0
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Base Link TF Path
      Topic:
        Value: /base_link_path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Line Style: Lines
      Line Width: 0.05
      Color: 0; 210; 255
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: lidar_odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Orbit
      Pitch: 0.8
      Target Frame: <Fixed Frame>
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
  X: 80
  Y: 40
